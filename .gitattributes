# Normalise to LF in the repository, check out native. Set at the initial commit so it never has to
# rewrite history later.
* text=auto

# Explicit, so a tool that guesses wrong cannot mangle them.
*.html  text
*.js    text
*.css   text
*.md    text
*.py    text
*.webp  binary

# The code graph is SQLite. diff=codegraph renders it as its JSON export in git diff for any clone
# that has run /codebase-kg:setup-diff; without the driver it simply falls back to "binary".
knowledge/code_graph.db binary diff=codegraph
